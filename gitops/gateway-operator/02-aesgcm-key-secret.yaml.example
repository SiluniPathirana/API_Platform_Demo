# NOT applied automatically — this is a template, not a real secret.
# The actual gateway-aesgcm-key Secret must be created out-of-band, per org
# security policy (never commit real key material to Git):
#
#   openssl rand 32 > /tmp/default-aesgcm256-v1.bin
#   kubectl create secret generic gateway-aesgcm-key -n default \
#     --from-file=default-aesgcm256-v1.bin=/tmp/default-aesgcm256-v1.bin
#
# Referenced by 01-gateway-custom-config.yaml's
# gateway.controller.encryptionKeys.secretName. Losing this key makes
# anything it encrypted unrecoverable — back it up the same way any other
# production secret is backed up, and never regenerate it casually.
apiVersion: v1
kind: Secret
metadata:
  name: gateway-aesgcm-key
  namespace: default
type: Opaque
data:
  default-aesgcm256-v1.bin: <REPLACE_WITH_BASE64_ENCODED_KEY>
